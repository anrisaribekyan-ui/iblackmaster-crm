# Домен, на который смотрит A-запись DNS (например crm.iblackmaster.ru) — тогда будет HTTPS.
# Для теста без домена: DOMAIN=:80 (обычный HTTP) и HTTP_PORT=8080 → http://IP:8080
DOMAIN=crm.example.ru
# Внешние порты. Меняйте, если 80/443 уже заняты (например VPN на том же сервере)
HTTP_PORT=80
HTTPS_PORT=443
# Длинный случайный пароль БД: openssl rand -hex 24
DB_PASSWORD=
# Секрет для входа в систему: openssl rand -hex 32
JWT_SECRET=
# Реестр образов. Если с сервера не скачивается Docker Hub — укажите зеркало хостинга
# (адрес вида <зеркало>/library), иначе оставьте как есть.
REGISTRY=docker.io/library
# Адрес CRM для клиентов — из него строится ссылка в QR и SMS (https://crm.example.ru)
PUBLIC_URL=
# SMS с рабочего Android-телефона: приложение SMS Gateway for Android → Cloud server → логин и пароль.
# Пусто — SMS не отправляются (шаблоны и журнал работают, сообщения копятся в очереди).
SMSGATE_USER=
SMSGATE_PASSWORD=

# Почта для писем сотрудникам (код «Забыли пароль?», «Пароль изменён», «Добро пожаловать»).
# Яндекс 360: SMTP_HOST=smtp.yandex.ru, Mail.ru: smtp.mail.ru. Порт 465.
# Пароль — «пароль приложения» из настроек безопасности почты, не обычный пароль от ящика.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Не больше SMS в сутки с одной симки (операторы блокируют массовые рассылки)
SMS_DAILY_LIMIT=150

# Доска закупок (раздел «Закупки»), адрес:порт сервиса «Доска»
DOSKA_UPSTREAM=217.179.49.241:8090

# Оформление заказов у поставщиков из «Закупок» (сервис zakupka_api.py в ~/moba на этом же сервере).
# Токен — тот же, что ZAKUPKA_TOKEN в ~/moba/.env. Пусто — кнопка «Оформить» скрыта.
ZAKUPKA_URL=http://host.docker.internal:8095
ZAKUPKA_TOKEN=
