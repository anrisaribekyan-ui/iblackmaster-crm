# Настройки скриптов обслуживания. Скопируйте в deploy/ops.env (он не попадает в git): cp ops.env.example ops.env && chmod 600 ops.env

# ── Бэкап ───────────────────────────────────────────────────────────────────
# Пароль шифрования бэкапов (restic): openssl rand -hex 24
# ВАЖНО: сохраните его в менеджере паролей ВНЕ этого сервера. Без него бэкапы не открыть, даже если они целы.
RESTIC_PASSWORD=

# Куда выгружать, через пробел (нужно хотя бы одно, лучше два в разных местах):
#   VPS по SSH:             sftp:crm-backup-vps:/srv/crm-backups     (crm-backup-vps — запись в /root/.ssh/config, см. ops/README.md)
#   Yandex Object Storage:  s3:https://storage.yandexcloud.net/ИМЯ_БАКЕТА
RESTIC_REPOS=

# Ключи доступа к бакету (только если есть s3:-хранилище): сервисный аккаунт с ролью storage.editor на этот бакет
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Уведомления в Telegram ──────────────────────────────────────────────────
# Бот: @BotFather → /newbot. Chat id: напишите боту и откройте https://api.telegram.org/bot<TOKEN>/getUpdates
TG_BOT_TOKEN=
TG_CHAT_ID=
# Если с сервера Telegram не открывается — прокси, например socks5h://127.0.0.1:1080
TG_PROXY=

# ── Автодеплой ──────────────────────────────────────────────────────────────
DEPLOY_BRANCH=main
