{$DOMAIN} {
	encode gzip
	# API → бэкенд
	handle /api/* {
		reverse_proxy backend:8000
	}
	# Страницы, service worker и manifest браузер всегда сверяет с сервером — иначе телефон застрянет на старой версии
	@fresh not path /assets/* /icons/* /api/*
	header @fresh Cache-Control "no-cache"
	# Файлы сборки с хэшем в имени не меняются — пусть браузер держит их год
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# Всё остальное — приложение (SPA)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin
	}
}
