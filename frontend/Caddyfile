{$DOMAIN} {
	encode gzip
	# API → бэкенд
	handle /api/* {
		reverse_proxy backend:8000
	}
	# Всё остальное — приложение (SPA)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin
	}
}
